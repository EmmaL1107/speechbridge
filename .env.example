# SpeechBridge 配置

# LLM 提供商: dashscope / deepseek / openai / anthropic / ollama
LLM_PROVIDER=dashscope

# 阿里百炼 API Key（SenseVoice ASR + Qwen LLM 共用）
DASHSCOPE_API_KEY=sk-xxx

# 其他 LLM API Key
OPENAI_API_KEY=sk-xxx
ANTHROPIC_API_KEY=sk-ant-xxx
DEEPSEEK_API_KEY=sk-xxx

# Ollama 地址 (本地 LLM)
OLLAMA_BASE_URL=http://localhost:11434

# ASR 模型: sensevoice-v1 / tiny / base / small / medium / large-v3-turbo
ASR_MODEL=sensevoice-v1

# LLM 模型 (dashscope 用 qwen-plus, deepseek 用 deepseek-chat)
LLM_MODEL=qwen-plus

# 默认场景: general / meeting / education / medical / accessibility
DEFAULT_SCENE=general

# 登录 Cookie HMAC 密钥，生产环境必须使用至少 32 字节随机值
AUTH_SECRET=replace-with-at-least-32-random-bytes

# 允许的 CORS Origin，逗号分隔；设为 * 时会关闭 credentials
CORS_ALLOWED_ORIGINS=http://localhost:8000,http://localhost:8501

# 单次音频上传最大字节数，默认 25MB
MAX_UPLOAD_BYTES=26214400

# SQLite 数据库路径
DB_PATH=speechbridge.db

# Demo 上传目录
UPLOAD_DIR=uploads
